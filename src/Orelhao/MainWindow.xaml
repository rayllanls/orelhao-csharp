<ui:FluentWindow x:Class="Orelhao.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="Orelhão"
                 Width="1040" Height="680"
                 MinWidth="860" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <!-- Item de navegação da barra lateral: ícone + rótulo, com barra de
             acento amarela e realce quando selecionado. RadioButton dá a seleção
             mútua entre topo e rodapé de graça (mesmo GroupName). -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Nav" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent" Padding="10,9">
                            <Grid>
                                <Border x:Name="Accent" Width="3" Height="18" CornerRadius="2"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{DynamicResource OrelhaoAccentBrush}"
                                        Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                    <ContentPresenter />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Conteúdo padrão de um item: ícone + texto. -->
        <!-- Ícone do menu na cor de destaque; o texto do item fica na cor da base. -->
        <Style x:Key="NavIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource OrelhaoAccentBrush}" />
        </Style>
        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Grid.ColumnSpan="2" Title="Orelhão" Height="36">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/icon.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Barra lateral -->
            <Border Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Itens principais -->
                    <StackPanel Grid.Row="0" Margin="0,8,0,0">
                        <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Tag="Home"
                                     Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Home24" Style="{StaticResource NavIcon}" />
                                <TextBlock Text="Início" Style="{StaticResource NavText}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" Tag="Groups" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Apps24" Style="{StaticResource NavIcon}" />
                                <TextBlock Text="Grupos" Style="{StaticResource NavText}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" Tag="Favorites" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Star24" Style="{StaticResource NavIcon}" />
                                <TextBlock Text="Favoritos" Style="{StaticResource NavText}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" Tag="History" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="History24" Style="{StaticResource NavIcon}" />
                                <TextBlock Text="Histórico" Style="{StaticResource NavText}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" Tag="Ip" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Globe24" Style="{StaticResource NavIcon}" />
                                <TextBlock Text="DNS &amp; IP" Style="{StaticResource NavText}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" Tag="Web" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ShieldTask24" Style="{StaticResource NavIcon}" />
                                <TextBlock Text="Inspeção Web" Style="{StaticResource NavText}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Rodapé de navegação -->
                    <StackPanel Grid.Row="1">
                        <RadioButton Style="{StaticResource NavItem}" Tag="Settings" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" Style="{StaticResource NavIcon}" />
                                <TextBlock Text="Configurações" Style="{StaticResource NavText}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" Tag="About" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Info24" Style="{StaticResource NavIcon}" />
                                <TextBlock Text="Sobre" Style="{StaticResource NavText}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Meu IP -->
                    <StackPanel Grid.Row="2" Margin="18,10,12,12">
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                CornerRadius="6" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="MyLocation24" FontSize="14" Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource OrelhaoAccentBrush}" />
                                <StackPanel>
                                    <TextBlock Text="Meu IP" FontSize="10"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="SidebarMyIp" FontSize="12" FontWeight="SemiBold"
                                               FontFamily="{StaticResource MonoFont}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Conteúdo. Foreground herdado pelas páginas: ícones e textos sem
                 cor própria seguem o tema (verde no tema Verde). -->
            <Frame x:Name="ContentFrame" Grid.Column="1" NavigationUIVisibility="Hidden"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
