<Page x:Class="Orelhao.Views.WebInspectorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Inspeção Web"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,16">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Inspeção Web" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"
                       Text="Cabeçalhos HTTP e certificado SSL/TLS de um alvo, sem abrir o navegador." />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="TargetBox" Grid.Column="0" Margin="0,0,8,0"
                            PlaceholderText="URL ou host (ex.: exemplo.com ou https://exemplo.com)"
                            Icon="{ui:SymbolIcon Globe24}" KeyDown="OnKeyDownTarget" />
                <ui:Button Grid.Column="1" x:Name="InspectButton" Content="Inspecionar"
                           Style="{StaticResource AccentButton}" Click="OnInspect" MinWidth="120" />
            </Grid>

            <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,4,0,0">
                <ui:ProgressRing IsIndeterminate="True" Width="22" Height="22" Margin="0,0,10,0" />
                <TextBlock Text="Inspecionando…" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ui:InfoBar x:Name="ErrorBar" Severity="Warning" IsClosable="True"
                        Title="Inspeção" Margin="0,8,0,0" IsOpen="False" />

            <!-- Certificado SSL/TLS -->
            <ui:Card x:Name="CertCard" Padding="16" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:SymbolIcon Symbol="LockClosed24" Margin="0,0,8,0"
                                       Foreground="{DynamicResource OrelhaoAccentBrush}" />
                        <TextBlock Text="Certificado SSL/TLS" FontWeight="SemiBold" FontSize="15"
                                   VerticalAlignment="Center" />
                        <Border x:Name="CertBadge" CornerRadius="10" Padding="8,1" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="CertBadgeText" FontSize="11" />
                        </Border>
                    </StackPanel>
                    <ItemsControl x:Name="CertList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                               FontFamily="{StaticResource MonoFont}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <!-- Cabeçalhos HTTP -->
            <ui:Card x:Name="HeadersCard" Padding="16" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Document24" Margin="0,0,8,0"
                                           Foreground="{DynamicResource OrelhaoAccentBrush}" />
                            <TextBlock x:Name="HeadersTitle" Text="Cabeçalhos HTTP" FontWeight="SemiBold"
                                       FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:Button Icon="{ui:SymbolIcon Copy24}" Content="Copiar" Appearance="Secondary"
                                   Padding="10,4" HorizontalAlignment="Right" Click="OnCopyHeaders" />
                    </Grid>
                    <ItemsControl x:Name="HeadersList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" TextWrapping="Wrap"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                               FontFamily="{StaticResource MonoFont}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
