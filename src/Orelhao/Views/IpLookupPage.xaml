<Page x:Class="Orelhao.Views.IpLookupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="DNS &amp; IP"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,16">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="DNS &amp; IP" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"
                       Text="Resolução de IP e consultas DNS usando os servidores configurados." />

            <!-- Meu IP -->
            <ui:Card Padding="16" Margin="0,0,0,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="MyLocation24" Margin="0,0,10,0"
                                       Foreground="{DynamicResource OrelhaoAccentBrush}" />
                        <StackPanel>
                            <TextBlock Text="Meu IP" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="MyIpText" FontSize="16" FontWeight="SemiBold"
                                       FontFamily="{StaticResource MonoFont}" />
                        </StackPanel>
                    </StackPanel>
                    <ui:Button Icon="{ui:SymbolIcon Copy24}" Content="Copiar" Appearance="Secondary"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnCopyMyIp" />
                </Grid>
            </ui:Card>

            <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0">
                <!-- ===== Aba IP ===== -->
                <TabItem Header="IP">
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="IP privado resolve pelo DNS interno; público consulta a internet; hostname resolve para IP." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="QueryBox" Grid.Column="0" Margin="0,0,8,0"
                                        PlaceholderText="IP ou hostname (ex.: 8.8.8.8 ou servidor.local)"
                                        Icon="{ui:SymbolIcon Search24}" KeyDown="OnQueryKeyDown" />
                            <ui:Button Grid.Column="1" x:Name="QueryButton" Content="Consultar"
                                       Style="{StaticResource AccentButton}" Click="OnQuery" MinWidth="110" />
                        </Grid>
                        <ui:Card x:Name="ResultCard" Padding="16" Margin="0,12,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock x:Name="ResultTitle" FontWeight="SemiBold" FontSize="15"
                                               VerticalAlignment="Center" />
                                    <ui:Button Icon="{ui:SymbolIcon Copy24}" Content="Copiar" Appearance="Secondary"
                                               Padding="10,4" HorizontalAlignment="Right" Click="OnCopyResult" />
                                </Grid>
                                <ItemsControl x:Name="ResultList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                                           FontFamily="{StaticResource MonoFont}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </TabItem>

                <!-- ===== Aba Registros DNS ===== -->
                <TabItem Header="Registros DNS">
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Consulta um tipo de registro (A, AAAA, CNAME, MX, TXT, NS, PTR) nos servidores configurados." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="DnsNameBox" Grid.Column="0" Margin="0,0,8,0"
                                        PlaceholderText="Domínio (ex.: exemplo.com)"
                                        Icon="{ui:SymbolIcon Globe24}" KeyDown="OnDnsKeyDown" />
                            <ComboBox x:Name="DnsTypeCombo" Grid.Column="1" Width="100" Margin="0,0,8,0" />
                            <ui:Button Grid.Column="2" x:Name="DnsButton" Content="Consultar"
                                       Style="{StaticResource AccentButton}" Click="OnDnsQuery" MinWidth="110" />
                        </Grid>
                        <ui:Card x:Name="DnsCard" Padding="16" Margin="0,12,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock x:Name="DnsResultTitle" FontWeight="SemiBold" FontSize="15"
                                               VerticalAlignment="Center" />
                                    <ui:Button Icon="{ui:SymbolIcon Copy24}" Content="Copiar" Appearance="Secondary"
                                               Padding="10,4" HorizontalAlignment="Right" Click="OnCopyDns" />
                                </Grid>
                                <ItemsControl x:Name="DnsResults">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Margin="0,2"
                                                       FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="DnsEmpty" Text="— nenhum registro encontrado —"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </TabItem>

                <!-- ===== Aba Propagação ===== -->
                <TabItem Header="Propagação">
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Pergunta o mesmo registro a cada servidor DNS ao mesmo tempo e compara as respostas — bom para achar inconsistências." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="PropNameBox" Grid.Column="0" Margin="0,0,8,0"
                                        PlaceholderText="Domínio (ex.: exemplo.com)"
                                        Icon="{ui:SymbolIcon Globe24}" KeyDown="OnPropKeyDown" />
                            <ComboBox x:Name="PropTypeCombo" Grid.Column="1" Width="100" Margin="0,0,8,0" />
                            <ui:Button Grid.Column="2" x:Name="PropButton" Content="Verificar"
                                       Style="{StaticResource AccentButton}" Click="OnPropQuery" MinWidth="110" />
                        </Grid>
                        <ItemsControl x:Name="PropResults" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Padding="14" Margin="0,0,0,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <ui:SymbolIcon Symbol="Server24" Margin="0,0,8,0"
                                                               Foreground="{DynamicResource OrelhaoAccentBrush}" />
                                                <TextBlock Text="{Binding Server}" FontWeight="SemiBold"
                                                           FontFamily="{StaticResource MonoFont}" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Lines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Margin="26,1,0,1"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- Progresso + erro (compartilhados) -->
            <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,12,0,0">
                <ui:ProgressRing IsIndeterminate="True" Width="22" Height="22" Margin="0,0,10,0" />
                <TextBlock Text="Consultando…" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ui:InfoBar x:Name="ErrorBar" Severity="Warning" IsClosable="True"
                        Title="Consulta" Margin="0,12,0,0" IsOpen="False" />
        </StackPanel>
    </ScrollViewer>
</Page>
