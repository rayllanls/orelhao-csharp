<Page x:Class="Orelhao.Views.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Histórico"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="24,16,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Histórico" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ui:Button HorizontalAlignment="Right" Content="Limpar histórico"
                       Icon="{ui:SymbolIcon Delete24}" Style="{StaticResource AccentButton}" Click="OnClear" />
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,80,0,0"
                        Visibility="{Binding History.Count, Converter={StaticResource EmptyToVisibility}}">
                <TextBlock Text="🕓" FontSize="48" HorizontalAlignment="Center" FontFamily="Segoe UI Emoji" />
                <TextBlock Text="Nada executado ainda" FontSize="18" FontWeight="Medium"
                           HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="Cada atalho executado aparece aqui."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,16">
                <ItemsControl ItemsSource="{Binding History}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Padding="10,8" Margin="0,2"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0"
                                                   Symbol="{Binding Icon, Converter={StaticResource IconToSymbol}}"
                                                   Foreground="{DynamicResource OrelhaoAccentBrush}"
                                                   FontSize="22" VerticalAlignment="Center" Margin="2,0,12,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Command}" FontSize="12"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding When}" FontSize="12"
                                               VerticalAlignment="Center" Margin="12,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon Play24}"
                                               Appearance="Secondary" Padding="8,4"
                                               ToolTip="Executar novamente" Click="OnRerun" Tag="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
