<Page x:Class="Orelhao.Views.FavoritesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Favoritos"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="24,16,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Favoritos" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,80,0,0" Visibility="Collapsed">
                <TextBlock Text="⭐" FontSize="48" HorizontalAlignment="Center" FontFamily="Segoe UI Emoji" />
                <TextBlock Text="Nenhum favorito ainda" FontSize="18" FontWeight="Medium"
                           HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="Marque a estrela de um atalho para vê-lo aqui."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,16">
                <ItemsControl x:Name="FavoritesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Padding="10,8" Margin="0,2"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0"
                                                   Symbol="{Binding Icon, Converter={StaticResource IconToSymbol}}"
                                                   Foreground="{DynamicResource OrelhaoAccentBrush}"
                                                   FontSize="24" VerticalAlignment="Center" Margin="2,0,12,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="14"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Command}" FontSize="12"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding GroupName}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Icon="{ui:SymbolIcon Play24}" Style="{StaticResource AccentButton}"
                                                   Padding="10,4" Margin="0,0,8,0" ToolTip="Executar"
                                                   Click="OnRun" Tag="{Binding}" />
                                        <ui:Button Content="★" FontSize="16" Padding="8,2"
                                                   Appearance="Secondary" ToolTip="Remover dos favoritos"
                                                   Click="OnUnfavorite" Tag="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
